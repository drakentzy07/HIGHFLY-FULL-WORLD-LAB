{
  "name": "HIGHFLY KayKit — ClaudeCraft v0.44.7 private lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "workspaceFolder": "/workspaces/HIGHFLY-FULL-WORLD-LAB",
  "forwardPorts": [
    4173,
    5173
  ],
  "portsAttributes": {
    "4173": {
      "label": "HIGHFLY 0.44.7 optimized private preview",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5173": {
      "label": "ClaudeCraft 0.44.7 development / editor",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash scripts/bootstrap_original.sh",
  "remoteUser": "node"
}
